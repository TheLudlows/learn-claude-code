# API Key (required)
ANTHROPIC_API_KEY=sk-ant-xxx
# 或使用 AUTH_TOKEN
# ANTHROPIC_AUTH_TOKEN=your-token-here

# Model ID (required)
MODEL_ID=claude-sonnet-4-6

# Base URL (optional, for Anthropic-compatible providers)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Skills directory (optional, default: ./skills).
# s07 scans <SKILLS_DIR>/*/SKILL.md at startup and puts the skill catalog in
# the system prompt; the full SKILL.md body is loaded on demand via load_skill.
# From rust-agent/, point at the repo root skills to load the 4 examples:
# SKILLS_DIR=../skills